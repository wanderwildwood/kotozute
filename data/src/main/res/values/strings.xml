    <plurals name="signal_update_you_invited">
        <item quantity="one">You invited %1$d person to the group.</item>
        <item quantity="other">You invited %1$d people to the group.</item>
    </plurals>
    <plurals name="signal_update_invited">
        <item quantity="one">%1$s invited %2$d person to the group.</item>
        <item quantity="other">%1$s invited %2$d people to the group.</item>
    </plurals>
    <string name="signal_update_you_removed">You removed %1$s.</string>
    <string name="signal_update_removed">%1$s removed %2$s.</string>
    <string name="signal_update_removed_you">%1$s removed you from the group.</string>
    <string name="signal_update_you_left">You left the group.</string>
    <string name="signal_update_left">%1$s left the group.</string>
    <string name="signal_update_you_made_admin">You made %1$s an admin.</string>
    <string name="signal_update_made_admin">%1$s made %2$s an admin.</string>
    <string name="signal_update_made_you_admin">%1$s made you an admin.</string>
    <string name="signal_update_you_revoked_admin">You revoked admin privileges from %1$s.</string>
    <string name="signal_update_revoked_admin">%1$s revoked admin privileges from %2$s.</string>
    <string name="signal_update_revoked_your_admin">%1$s revoked your admin privileges.</string>
    <string name="signal_update_you_admins_only">You changed the group settings to only allow admins to send messages.</string>
    <string name="signal_update_admins_only">%1$s changed the group settings to only allow admins to send messages.</string>
    <string name="signal_update_you_all_send">You changed the group settings to allow all members to send messages.</string>
    <string name="signal_update_all_send">%1$s changed the group settings to allow all members to send messages.</string>
    <string name="signal_update_you_edit_admins">You changed who can edit group info to \"Only admins\".</string>
    <string name="signal_update_edit_admins">%1$s changed who can edit group info to \"Only admins\".</string>
    <string name="signal_update_you_edit_all">You changed who can edit group info to \"All members\".</string>
    <string name="signal_update_edit_all">%1$s changed who can edit group info to \"All members\".</string>
    <string name="signal_update_you_add_admins">You changed who can edit group membership to \"Only admins\".</string>
    <string name="signal_update_add_admins">%1$s changed who can edit group membership to \"Only admins\".</string>
    <string name="signal_update_you_add_all">You changed who can edit group membership to \"All members\".</string>
    <string name="signal_update_add_all">%1$s changed who can edit group membership to \"All members\".</string>
    <string name="signal_update_you_link_on">You turned on the group link with admin approval off.</string>
    <string name="signal_update_link_on">%1$s turned on the group link with admin approval off.</string>
    <string name="signal_update_you_link_approval">You turned on the group link with admin approval on.</string>
    <string name="signal_update_link_approval">%1$s turned on the group link with admin approval on.</string>
    <string name="signal_update_you_link_off">You turned off the group link.</string>
    <string name="signal_update_link_off">%1$s turned off the group link.</string>
    <string name="signal_update_asked_to_join">%1$s requested to join via the group link.</string>
    <string name="signal_update_you_approved">You approved a request to join the group from %1$s.</string>
