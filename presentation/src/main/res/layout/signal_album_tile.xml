<?xml version="1.0" encoding="utf-8"?>
<!-- One picture of several sent together. Square and cropped, as Signal draws an album, so
     four of them sit as a block the width of a single picture rather than a column four
     pictures tall. The label stands in where there is no picture to draw: a video, a file,
     or one that is not on the phone. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="116dp"
    android:layout_height="116dp"
    android:layout_margin="2dp"
    android:background="@drawable/rounded_rectangle_outline_2dp">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/signal_attachment_image"
        android:scaleType="centerCrop" />

    <!-- Half size, as upstream halves its overlay on a thumbnail under twice its width.
         Scaled rather than drawn at 24dp: the triangle's inset is fixed dp and would eat it. -->
    <ImageView
        android:id="@+id/playOverlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="@string/signal_play_video"
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:src="@drawable/signal_play_overlay"
        android:visibility="gone" />

    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/label"
        style="@style/TextTertiary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="4"
        android:padding="6dp" />

</FrameLayout>
