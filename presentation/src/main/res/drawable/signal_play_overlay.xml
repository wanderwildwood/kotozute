<?xml version="1.0" encoding="utf-8"?>
<!-- The mark on a video's first frame that says it plays, as Signal's ThumbnailView draws it
     (play_overlay: a 48dp round background, triangle_right inset 12dp). Solid black under a
     white triangle rather than upstream's translucent grey: a see-through fill dithers on
     e-ink and would vanish on a dark frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF000000" />
            <stroke
                android:width="1dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M20.93 13.5c1.15-0.67 1.15-2.33 0-3L7.76 2.71C6.6 2.03 5.13 2.88 5.13 4.23v15.54c0 1.35 1.47 2.2 2.63 1.5l13.17-7.76Z" />
        </vector>
    </item>
</layer-list>
