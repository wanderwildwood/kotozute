<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppLaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- No scrollbars: a list moves a page to a swipe, and nothing else needs one. -->
        <item name="android:scrollbarThumbVertical">@android:color/transparent</item>
        <item name="android:scrollbarThumbHorizontal">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <!-- Android 12+ splash screen - use transparent icon -->
        <item name="android:windowSplashScreenBackground">@color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
    </style>

</resources>
