<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Toolbar"
            android:animateLayoutChanges="false"
            app:contentInsetStartWithNavigation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/toolbarContent"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Menu Icon -->
                <ImageView
                    android:id="@+id/settingsIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu_24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/drawer_settings"
                    app:tint="#000000" />

                <!-- Page title. Must live INSIDE toolbarContent: as a direct child of
                     the Toolbar it was a sibling of toolbarContent (match_parent), which
                     consumed the full width and left the title measuring 0px wide. -->
                <com.wanderwildwood.kotozute.common.widget.QkTextView
                    android:id="@+id/toolbarTitle"
                    style="@style/ToolbarText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:text="@string/title_conversations" />

                <!-- Filter Tabs with Search and Compose -->
                <!-- Weighted rather than wrap_content: at wrap_content the labels set the
                     width, and three of them at 48dp targets ran past the right edge of a
                     480px screen. Weighted, the row takes the space that is left and the
                     tabs inside share it. -->
                <LinearLayout
                    android:id="@+id/filterTabs"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal">

                    <!-- Search Tab -->
                    <FrameLayout
                        android:id="@+id/searchIcon"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_search_black_24dp"
                            app:tint="#000000" />

                    </FrameLayout>

                    <!-- QkTextView, so the label follows the app's Font size setting
                         like every other piece of text instead of a hardcoded 13sp. -->
                    <com.wanderwildwood.kotozute.common.widget.QkTextView
                        android:id="@+id/filterAll"
                        android:layout_width="wrap_content"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:minWidth="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/filter_all"
                        android:textStyle="bold"
                        android:background="@drawable/filter_tab_selected"
                        android:textColor="@android:color/white"
                        app:textSize="secondary" />

                    <!-- QkTextView, so the label follows the app's Font size setting
                         like every other piece of text instead of a hardcoded 13sp. -->
                    <com.wanderwildwood.kotozute.common.widget.QkTextView
                        android:id="@+id/filterGroups"
                        android:layout_width="wrap_content"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:minWidth="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/filter_groups"
                        android:textStyle="bold"
                        android:background="@android:color/transparent"
                        android:textColor="#000000"
                        app:textSize="secondary" />

                    <!-- QkTextView, so the label follows the app's Font size setting
                         like every other piece of text instead of a hardcoded 13sp. -->
                    <com.wanderwildwood.kotozute.common.widget.QkTextView
                        android:id="@+id/filterUnknown"
                        android:layout_width="wrap_content"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:minWidth="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/filter_unknown"
                        android:textStyle="bold"
                        android:background="@android:color/transparent"
                        android:textColor="#000000"
                        app:textSize="secondary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Search input container - takes over entire toolbar when active -->
            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/searchBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back_black_24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/abc_action_bar_up_description"
                    app:tint="#000000" />

                <com.wanderwildwood.kotozute.common.widget.QkEditText
                    android:id="@+id/toolbarSearch"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/rounded_rectangle_24dp"
                    android:backgroundTint="#F0F0F0"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:hint="Search"
                    android:textSize="16sp"
                    android:imeOptions="actionSearch" />

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <com.wanderwildwood.kotozute.common.widget.QkTextView
            android:id="@+id/empty"
            style="@style/TextSecondary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="56dp"
            app:layout_constraintBottom_toTopOf="@id/bottom"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            tools:text="Your conversations will appear here"
            tools:visibility="invisible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/bottom"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            tools:listitem="@layout/conversation_list_item" />

        <!-- A drawn line rather than the inherited 8dp gradient: a soft shadow is
             dithered noise on e-ink, and this is the same weight of stroke the
             filter pill used to carry. -->
        <View
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <!-- Compose. Floats over the list in the bottom end corner rather than
             sitting in the filter pill, where it and the search icon between them
             took 96dp of a 480px-wide bar and squeezed the labels. -->
        <FrameLayout
            android:id="@+id/compose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/compose_button_background"
            app:layout_constraintBottom_toTopOf="@id/bottom"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit_black_24dp"
                android:contentDescription="@string/main_fab_cd"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <View
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="?android:attr/divider"
            app:layout_constraintBottom_toTopOf="@id/snackbar" />

        <ViewStub
            android:id="@+id/snackbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inflatedId="@id/snackbar"
            android:layout="@layout/main_permission_hint"
            app:layout_constraintBottom_toTopOf="@id/syncing" />

        <ViewStub
            android:id="@+id/syncing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inflatedId="@id/syncing"
            android:layout="@layout/main_syncing"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/drawer"
        layout="@layout/drawer_view"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>