    <string name="signal_call_missed_video">Verpasster Videoanruf</string>
    <string name="signal_call_answered_voice">Sprachanruf, auf einem anderen Gerät angenommen</string>
    <string name="signal_call_answered_video">Videoanruf, auf einem anderen Gerät angenommen</string>
    <string name="signal_call_declined_voice">Sprachanruf, auf einem anderen Gerät abgelehnt</string>
