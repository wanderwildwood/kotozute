<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/toolbarTitle"
                style="@style/ToolbarText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp" />

            <!-- In the title's place while the lists are kept apart, as the SMS list has
                 them: the same tabs, less Unknown, which a Signal thread never is. -->
            <LinearLayout
                android:id="@+id/filterTabs"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal"
                android:visibility="gone">

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/filter_all"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:textColor="#000000"
                app:textSize="secondary" />

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/filterGroups"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/filter_groups"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:textColor="#000000"
                app:textSize="secondary" />

            </LinearLayout>

            <!-- Crosses back to the SMS list. Present only while the two lists are being
                 kept apart; woven, this screen is not reached from a list at all. -->
            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/railBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/rail_badge_touch"
                android:minHeight="48dp"
                android:gravity="center"
                android:contentDescription="@string/title_conversations"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="@string/signal_rail_label_switch"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@android:color/black" />

    <!-- Says plainly when the bridge is unreachable. Receiving catches up on its own,
         but sending cannot happen, so this is not decoration. -->
    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Cannot reach the bridge"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- The list and the compose button share this space so the button floats over the
         list in the corner, the same place and the same size as the SMS inbox's. Both rails
         are the same app on the same panel; a conversation is started the same way in each. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.wanderwildwood.kotozute.common.widget.QkTextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/signal_empty"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/compose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/compose_button_background">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit_black_24dp"
                android:contentDescription="@string/signal_new_conversation_cd"
                app:tint="#FFFFFF"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

        </FrameLayout>

    </FrameLayout>

</LinearLayout>
