    <string name="signal_update_timer">%1$s set the disappearing message timer to %2$s.</string>
    <string name="signal_update_you_renamed">You changed the group name to \"%1$s\".</string>
    <string name="signal_update_renamed">%1$s changed the group name to \"%2$s\".</string>
    <string name="signal_update_you_description">You changed the group description.</string>
    <string name="signal_update_description">%1$s changed the group description.</string>
    <string name="signal_update_you_avatar">You changed the group avatar.</string>
    <string name="signal_update_avatar">%1$s changed the group avatar.</string>
