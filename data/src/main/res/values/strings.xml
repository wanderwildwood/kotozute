<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The name of the conversation with yourself.

      Here rather than in the presentation module because the thread is named where it is
      created, which is in this module. Signal's own clients use the same words.
    -->
    <string name="signal_note_to_self">Note to Self</string>

    <!--
      The first line of a group this phone just made.

      Signal writes an update into the conversation at both ends: "You created the group."
      to whoever made it, "X added you to the group." to everybody else
      (GroupsV2UpdateMessageProducer). This app has no update row, only messages, so it says
      the same thing as one. The receiving side's wording is in ContentNormalizer.describe,
      which has no Context to read a resource with; see the note there.
    -->
    <string name="signal_group_created_by_you">You created the group.</string>
    <!--
      Shown in place of a message this phone asked for again and never got. Said plainly and
      without blame: nobody did anything wrong, and the reader can act on it only by asking the
      person directly, so that is what it suggests.
    -->
    <!--
      Shown in a conversation when somebody's Signal profile name replaces a different one this
      phone already held. Both names, because which one is new is the whole information, and a
      reader who does not recognise the change is the reader this line exists for.
    -->
    <!--
      Shown in a conversation when somebody's Signal number replaces a different one this phone
      held. Both numbers, because in this app a person is one row across two rails and the
      number is what pairs the text half of it, so the old one is what the reader may have
      been texting.
    -->
    <!--
      Shown in a conversation after a second one was folded into it. Names what the other side
      was known by, because that is what lets a reader recognise which conversation has just
      disappeared from their inbox.
    -->
    <string name="signal_threads_joined">This conversation and the one with %1$s turned out to be the same person, so they are now one.</string>
    <string name="signal_number_changed">Their number changed from %1$s to %2$s.</string>
    <string name="signal_profile_name_changed">%1$s is now called %2$s.</string>
    <string name="signal_message_unreadable">A message was sent here that this phone could not read. It asked for it again and it did not come. Ask them to send it once more.</string>
    <!--
      Shown in place of a message whose sender marked it as needing a newer version of Signal
      than this app implements. Deliberately says nothing about what the message was: this
      build cannot know, and guessing is the fault being avoided.
    -->
    <string name="signal_message_needs_update">A message was sent here that this app is too old to show properly. Read it on another device until this one is updated.</string>
    <!--
      Their Signal, not ours. Upstream's wording for the same case asks the reader to have the
      sender update and send again, which is the only thing that can work.
    -->
    <string name="signal_message_sender_too_old">A message was sent here with a version of Signal this app can no longer read. Ask them to update Signal and send it again.</string>
    <!--
      Neither end named, because this build genuinely cannot tell which one is wrong: the
      ciphertext is in a version it does not speak. Saying whose fault it is would be a guess.
    -->
    <string name="signal_message_unreadable_form">A message was sent here that this app could not read. Asking for it again would not help.</string>
</resources>
