<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        app:textSize="primary"
        tools:text="Messaging 1.5.3" />

    <!-- What it sends, before the licence. This app serves a web page off the phone, which
         is not what a stranger would assume of a texting app, and the house rule is that
         the ones which cannot be safely assumed say so here. -->
    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/about_collects"
        app:textSize="secondary" />

    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/about_license"
        app:textSize="secondary" />

    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_fork"
        app:textSize="secondary" />

    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/about_source"
        app:textSize="secondary" />

    <!-- A llama, and the page a donation goes to. Last, under the source, where somebody
         who went looking will find it and nobody else has to read past it. -->
    <LinearLayout
        android:id="@+id/llama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/llama" />

        <com.wanderwildwood.kotozute.common.widget.QkTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/about_llama"
            app:textSize="secondary" />

    </LinearLayout>

</LinearLayout>
