<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/toolbarTitle"
                style="@style/ToolbarText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Crosses back to the SMS list. Present only while the two lists are being
                 kept apart; woven, this screen is not reached from a list at all. -->
            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/railBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/rail_badge_touch"
                android:minHeight="48dp"
                android:gravity="center"
                android:contentDescription="@string/title_conversations"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="@string/signal_rail_label_switch"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <include layout="@layout/top_bar_rule" />

    <!-- Says plainly when the bridge is unreachable. Receiving catches up on its own,
         but sending cannot happen, so this is not decoration. -->
    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Cannot reach the bridge"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- The list takes everything above the bar. The new-message action used to float here
         in the corner; it is a tab in the bar below now, as on the text list. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.wanderwildwood.kotozute.common.widget.QkTextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/signal_empty"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

    </FrameLayout>

    <!-- The filters and the new-message action, in the same bar as the text list's. They
         were pills in the top bar and a floating button; one app navigates one way. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/tabsCompose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
