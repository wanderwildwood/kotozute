<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/conversation_list_item_background"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.wanderwildwood.kotozute.common.widget.QkTextView
            android:id="@+id/title"
            style="@style/TextPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold" />

        <!-- Was the word "Signal" on every row. This list is nothing but Signal, so it
             said the same thing 55 times; the time is what a row here was missing. -->
        <com.wanderwildwood.kotozute.common.widget.QkTextView
            android:id="@+id/timestamp"
            style="@style/TextTertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp" />

    </LinearLayout>

    <!-- Unread is drawn in code exactly as the merged list draws it (ConversationsAdapter):
         bold snippet and time, and the dot. This row had neither, so with the lists apart
         nothing on it said a thread was waiting. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.wanderwildwood.kotozute.common.widget.QkTextView
            android:id="@+id/subtitle"
            style="@style/TextSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/unread"
            android:layout_width="20dp"
            android:layout_height="16sp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:src="@drawable/circle"
            android:visibility="gone"
            app:tint="@android:color/black" />
    </LinearLayout>

</LinearLayout>
