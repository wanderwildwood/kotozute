    <string name="signal_call_outgoing_voice">Ausgehender Sprachanruf, von einem anderen Gerät</string>
    <string name="signal_call_outgoing_video">Ausgehender Videoanruf, von einem anderen Gerät</string>
    <string name="signal_call_here_voice">Sprachanruf</string>
