<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false">

    <!-- The toolbar is the platform's, because the selection menu (archive, delete, and the
         rest) is still a menu. Its content is Compose: MainToolbarContent draws the title at
         the left and the search and settings controls at the right, in the MMD house style. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        android:animateLayoutChanges="false"
        app:contentInsetStart="16dp"
        app:contentInsetStartWithNavigation="0dp"
        app:contentInsetEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/toolbarCompose"
            android:layout_width="match_parent"
            android:layout_height="64dp" />

    </androidx.appcompat.widget.Toolbar>

    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/empty"
        style="@style/TextSecondary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="56dp"
        app:layout_constraintBottom_toTopOf="@id/snackbar"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:text="Your conversations will appear here"
        tools:visibility="invisible" />

    <!-- Fills the space between the toolbar and the snackbar. The snackbar is GONE most of
         the time, and a GONE view collapses to a point at the tabs' top, so the list runs to
         the tab bar and shrinks only while the hint is showing. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/snackbar"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:listitem="@layout/conversation_list_item"
        android:scrollbars="none" />

    <!-- A drawn line rather than the inherited 8dp gradient: a soft shadow is dithered
         noise on e-ink. 1dp, Mudita's own rule under a top bar. -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Bottom tab bar (in Compose). Pinned to the parent bottom ONLY: with two vertical
         constraints and wrap_content, ConstraintLayout would centre it, which is what once
         pushed the snackbar and the whole chain into the middle of the screen. The compose
         action is a tab in this bar now, so the old floating button is gone. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/tabsCompose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ViewStub
        android:id="@+id/snackbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inflatedId="@id/snackbar"
        android:layout="@layout/main_permission_hint"
        app:layout_constraintBottom_toTopOf="@id/tabsCompose" />

    <!-- Anchored above the tab bar so it can never overlap it. It no longer takes the parent
         bottom, which only tabsCompose owns. -->
    <ViewStub
        android:id="@+id/syncing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inflatedId="@id/syncing"
        android:layout="@layout/main_syncing"
        app:layout_constraintBottom_toTopOf="@id/tabsCompose" />

</androidx.constraintlayout.widget.ConstraintLayout>
