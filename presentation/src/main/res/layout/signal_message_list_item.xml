<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the SMS thread's look: outlined bubbles, a centred timestamp above a group,
     and the side telling you who spoke. The SMS item carries MMS parts, reactions, avatars
     and a SIM indicator that Signal has no equivalent for, so this is the shape of that
     layout rather than a copy of it, drawn with the same bubble drawables and text styles
     so the two threads read as one app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Centred, and shown only where there is a real gap in the conversation, exactly as
         the SMS thread does it. -->
    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/timestamp"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:padding="8dp" />

    <!-- Only ever visible in a group thread; a one-to-one thread's title already says. -->
    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/sender"
        style="@style/TextTertiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <!--
        Signal's own media bubble sizes: 240x320dp at most, 150x100dp at least
        (`media_bubble_max_width`, `media_bubble_max_height`, `media_bubble_min_width_solo`,
        `media_bubble_min_height`). Used rather than invented, because "how big is a picture
        in a conversation" is a question every messaging app has already answered the same way.

        ⚠ The **minimum** is the part that matters here. With only a height cap and
        wrap_content, a portrait photo was capped by its long edge and came out about half
        the panel wide — which is what the forum meant by "only very small". A minimum width
        stops the tall ones shrinking to a sliver.

        ⚠ 320dp is roughly 420px on this 210dpi panel, so it stays inside
        [SignalAttachment.THUMBNAIL_EDGE] (480px) and the bitmap is never upscaled. Raising
        the cap past that would need the decode bound raised with it.

        Tapping still opens the full picture; this is only what it looks like in the thread.

        A GIF is drawn here too, as its first frame, and plays once in place when tapped,
        never on its own and never in a loop. One sent from Signal's keyboard is a short
        MP4, which needs a surface to play on: `gifPlayer`, laid over the still and the same
        size, shown only while it plays. Its first frame arrives over a still that is
        already there, so there is no blank moment between the two.
    -->
    <FrameLayout
        android:id="@+id/imageFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp">

        <ImageView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/signal_attachment_image"
            android:visibility="gone"
            android:minWidth="150dp"
            android:minHeight="100dp"
            android:maxWidth="240dp"
            android:maxHeight="320dp" />

        <TextureView
            android:id="@+id/gifPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Several attachments on one message: an album. Only the first used to be drawn, so a
         message of four photos showed one. Two across, filled in code from
         signal_album_tile, and only used when there is more than one. -->
    <GridLayout
        android:id="@+id/album"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:columnCount="2"
        android:visibility="gone" />

    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/attachment"
        style="@style/TextTertiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <!-- What this message is replying to, when it quotes something. Above the bubble and
         set in the muted colour, so it reads as context rather than as another message: a
         reply that answers nothing visible is the thing this exists to prevent. -->
    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/quote"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"

        android:visibility="gone" />

    <!-- The bubble. Its background is chosen per message so a run from one person draws as
         one shape, the same four-way first/middle/last/only the SMS thread uses. -->
    <com.wanderwildwood.kotozute.common.widget.TightTextView
        android:id="@+id/body"
        style="@style/TextPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/message_in_only"
        android:gravity="start|center_vertical"
        android:minHeight="36dp" />

    <!-- Reactions others have put on this message. Drawn under the bubble rather than
         overlapping its corner as the SMS thread does: this is a LinearLayout, not the
         RelativeLayout that lets that one hang a chip off the edge, and an overlap that has
         to be faked with negative margins is worse than a line of its own. -->
    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/message_in_only"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="❤️ 2"
        tools:visibility="visible" />

    <!-- Words, not ticks. Two grey check marks are a convention people learn from other apps
         and read badly at this size on a low-contrast panel; "Delivered" needs no legend.
         Shown only on our own messages, and only once something is actually known. -->
    <com.wanderwildwood.kotozute.common.widget.QkTextView
        android:id="@+id/status"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:visibility="gone"
        tools:text="Delivered"
        tools:visibility="visible" />

</LinearLayout>
