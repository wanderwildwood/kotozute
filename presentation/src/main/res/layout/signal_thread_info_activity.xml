<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/toolbarTitle"
                style="@style/ToolbarText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp" />

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/railBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/filter_tab_selected"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="@string/signal_rail_label"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@android:color/black" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/name"
                style="@style/TextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- The number, when Signal reports one. It often does not for someone who has
                 never been messaged, and inventing a placeholder would say more than we know. -->
            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/number"
                style="@style/TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="2dp"
                android:paddingEnd="16dp"
                android:visibility="gone" />

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/counts"
                style="@style/TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp" />

            <!-- Group members. Gone entirely on a one-to-one thread rather than shown empty. -->
            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/membersHeading"
                style="@style/TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:text="@string/signal_info_members"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/members"
                style="@style/TextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <com.wanderwildwood.kotozute.common.widget.QkTextView
                android:id="@+id/mediaHeading"
                style="@style/TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="@android:color/black" />

            <com.wanderwildwood.kotozute.common.widget.PreferenceView
                android:id="@+id/archive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/info_archive"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <!-- Reaches the Signal account, not just this phone, so it holds everywhere.
                 Arms and confirms: it is outward-facing and not obviously undone. -->
            <com.wanderwildwood.kotozute.common.widget.PreferenceView
                android:id="@+id/block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                xmlns:app2="http://schemas.android.com/apk/res-auto"
                app2:title="@string/info_block" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
